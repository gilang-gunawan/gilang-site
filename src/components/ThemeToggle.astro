---
// ThemeToggle.astro — Dark mode toggle using is-dark / is-light classes
---

<button
  data-theme-toggle
  aria-label="Toggle dark mode"
  class="p-2 rounded-md transition-colors duration-150 cursor-pointer"
  style="color: var(--color-text-muted); background: transparent; border: none;"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg
    data-icon-sun
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="hidden"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
  </svg>

  <!-- Moon icon (shown in light mode) -->
  <svg
    data-icon-moon
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<script>
  const html = document.documentElement;

  function getTheme(): 'dark' | 'light' {
    const stored = localStorage.getItem('theme');
    if (stored === 'dark' || stored === 'light') return stored;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme(theme: 'dark' | 'light') {
    if (theme === 'dark') {
      html.classList.remove('is-light');
      html.classList.add('is-dark');
      document.querySelectorAll('[data-icon-sun]').forEach(el => el.classList.remove('hidden'));
      document.querySelectorAll('[data-icon-moon]').forEach(el => el.classList.add('hidden'));
    } else {
      html.classList.remove('is-dark');
      html.classList.add('is-light');
      document.querySelectorAll('[data-icon-sun]').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('[data-icon-moon]').forEach(el => el.classList.remove('hidden'));
    }
  }

  // Apply correct theme on load
  applyTheme(getTheme());

  // Wire up all toggle buttons
  document.querySelectorAll('[data-theme-toggle]').forEach(toggle => {
    toggle.addEventListener('click', () => {
      const current = html.classList.contains('is-dark') ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      applyTheme(next);
    });
  });
</script>

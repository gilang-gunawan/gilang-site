---
import site from "../content/config/site.json";
import { contact, getSocialLinks } from "../site.config";

const socialLinks = getSocialLinks();

const navLinks = [
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
  { href: "/resume", label: "Resume" },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Top row: Nav + Social -->
    <div class="footer-top">
      <nav class="footer-nav" aria-label="Footer navigation">
        {
          navLinks.map((link) => (
            <a href={link.href} class="footer-nav-link">
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="footer-social">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              class="footer-social-link"
              title={link.label}
            >
              <Fragment set:html={link.icon} />
            </a>
          ))
        }
        {
          contact.email && contact.email.trim() !== "" && (
            <a
              href={`mailto:${contact.email}`}
              aria-label="Email"
              class="footer-social-link"
              title="Email"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </a>
          )
        }
      </div>
    </div>

    <!-- Divider -->
    <div class="footer-divider" aria-hidden="true"></div>

    <!-- Bottom row: Copyright + Built with -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {year}&nbsp;
        {site.name}
      </p>
      <p class="footer-built-with">
        Built with&nbsp;
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-astro-link"
        >
          <!-- Astro icon -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 85 107"
            fill="currentColor"
            aria-hidden="true"
            style="display:inline;vertical-align:-2px;"
          >
            <path
              d="M53.6 1.8c.5 1 .5 2.1.3 3.1l-14.8 55.3a1 1 0 0 1-1.9 0L23.5 5c-.3-1.3-.2-2.6.4-3.8C27.5-3.6 62-3.6 65.8 1.8H53.6Z"
              opacity=".4"></path>
            <path
              d="M55.4 3.1C50.5.3 34.7.3 29.8 3.1a4.4 4.4 0 0 0-2 2.5L13.6 61.9A47.7 47.7 0 0 1 42.5 52a47.7 47.7 0 0 1 28.9 9.9L57.4 5.5a4.4 4.4 0 0 0-2-2.4Z"
            ></path>
            <path
              d="M42.5 54.4C26.4 54.4 13 64.7 7 79.1L.7 100.8a4 4 0 0 0 3.8 5.2h76a4 4 0 0 0 3.8-5.2L78 79.1C72.1 64.7 58.7 54.4 42.5 54.4Z"
              opacity=".4"></path>
          </svg>
          Astro
        </a>
        &nbsp;·&nbsp; Deployed on &nbsp;
        <a
          href="https://pages.cloudflare.com"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-astro-link"
        >
          Cloudflare Pages
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .footer-inner {
    padding: 1.5rem var(--layout-padding-horizontal) 1.25rem;
  }

  /* ── Top Row ─────────────────────────────────────────── */
  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .footer-nav-link {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: var(--border-radius);
    transition:
      color 150ms ease,
      background 150ms ease;
  }

  .footer-nav-link:hover {
    color: var(--color-text);
    background: var(--color-background-alternate);
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .footer-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--border-radius);
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color 150ms ease,
      background 150ms ease;
  }

  .footer-social-link:hover {
    color: var(--color-text);
    background: var(--color-background-alternate);
  }

  /* ── Divider ─────────────────────────────────────────── */
  .footer-divider {
    height: 1px;
    background: var(--color-border);
    margin: 1rem 0;
    opacity: 0.6;
  }

  /* ── Bottom Row ──────────────────────────────────────── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .footer-copyright,
  .footer-built-with {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-astro-link {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-style: dotted;
    transition: color 150ms ease;
  }

  .footer-astro-link:hover {
    color: var(--color-primary);
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 600px) {
    .footer-top,
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .footer-social {
      gap: 0.125rem;
    }
  }
</style>

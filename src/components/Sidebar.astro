---
import ThemeToggle from './ThemeToggle.astro';
import site from '../content/config/site.json';

const navLinks = [
  {
    href: '/',
    label: 'Home',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>`,
  },
  {
    href: '/blog',
    label: 'Blog',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  },
  {
    href: '/about',
    label: 'About',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>`,
  },
  {
    href: '/projects',
    label: 'Projects',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>`,
  },
  {
    href: '/resume',
    label: 'Resume',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>`,
  },
];

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/' && pathname === '/') return true;
  if (href !== '/' && pathname.startsWith(href)) return true;
  return false;
}
---

<!-- Desktop Sidebar -->
<aside class="sidebar">
  <!-- Section 1: Site name + theme toggle -->
  <div class="sidebar-section">
    <div class="sidebar-title-link">
      <a href="/" aria-label="Home" style="text-decoration: none;">
        <span class="site-name">{site.name}</span>
      </a>
      <ThemeToggle />
    </div>
  </div>

  <!-- Section 2: Short bio -->
  <div class="sidebar-section sidebar-content">
    <p>{site.tagline}</p>
  </div>

  <!-- Section 3: Main nav links -->
  <div class="sidebar-section">
    <nav aria-label="Main navigation" class="sidebar-nav-links">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[{ active: isActive(link.href) }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          <Fragment set:html={link.icon} />
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  <!-- Section 4: Social / external links -->
  <div class="sidebar-section">
    <div class="sidebar-links">
      {site.social.github && (
        <a href={site.social.github} target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </a>
      )}
      {site.social.bluesky && (
        <a href={site.social.bluesky} target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.377 5.65.6 6.304.78 2.29 3.511 3.09 6.012 2.651-3.69 1.15-5.26 4.383-2.923 7.82 2.337 3.437 6.13.9 8.311-1.043 2.181 1.943 5.974 4.48 8.311 1.043 2.337-3.437.767-6.67-2.923-7.82 2.501.439 5.232-.361 6.012-2.651.223-.654.6-5.614.6-6.304 0-.688-.139-1.86-.902-2.203-.659-.299-1.664-.621-4.3 1.24C16.046 4.747 13.087 8.686 12 10.8z"/>
          </svg>
          Bluesky
        </a>
      )}
      {site.social.linkedin && (
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
      )}
      <a href={`mailto:${site.email}`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        Email
      </a>
    </div>
  </div>

  <!-- Footer: copyright -->
  <div class="sidebar-section">
    <p style="font-size: 13px; color: var(--color-text-muted); margin: 0;">
      &copy; {new Date().getFullYear()} {site.name}
    </p>
  </div>
</aside>

<!-- Mobile header (shown on small screens) -->
<header class="mobile-header">
  <a href="/" aria-label="Home" style="text-decoration: none;">
    <span class="site-name">{site.name}</span>
  </a>
  <div class="mobile-header-right">
    <ThemeToggle />
    <button
      id="mobile-menu-btn"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-nav"
      style="background: transparent; border: none; padding: 0.5rem; cursor: pointer; color: var(--color-text-muted); border-radius: 6px;"
    >
      <!-- Hamburger icon -->
      <svg id="icon-hamburger" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <!-- Close icon -->
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile nav drawer -->
<nav
  id="mobile-nav"
  class="mobile-nav"
  aria-label="Mobile navigation"
  aria-hidden="true"
>
  {navLinks.map((link) => (
    <a
      href={link.href}
      class:list={['mobile-nav-link', { 'mobile-nav-link--active': isActive(link.href) }]}
      aria-current={isActive(link.href) ? 'page' : undefined}
    >
      {link.label}
    </a>
  ))}
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');
  const iconHamburger = document.getElementById('icon-hamburger');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('mobile-nav--open');
    btn.setAttribute('aria-expanded', String(!!isOpen));
    nav?.setAttribute('aria-hidden', String(!isOpen));
    iconHamburger?.classList.toggle('hidden', !!isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>

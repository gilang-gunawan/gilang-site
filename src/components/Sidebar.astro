---
import ThemeToggle from './ThemeToggle.astro';
import site from '../content/config/site.json';
import { contact, getSocialLinks } from '../site.config';

const socialLinks = getSocialLinks();

const navLinks = [
  {
    href: '/projects',
    label: 'Projects',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>`,
  },
  {
    href: '/blog',
    label: 'Blog',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  },
  {
    href: '/about',
    label: 'About',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>`,
  },
  {
    href: '/resume',
    label: 'Resume',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>`,
  },
  {
    href: '/chat',
    label: 'Ask AI',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>`,
  },
];

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  return pathname === href || (href !== '/' && pathname.startsWith(href));
}
---

<!-- Desktop Sidebar -->
<aside class="sidebar">
  <!-- Section 1: Site name + theme toggle -->
  <div class="sidebar-section">
    <div class="sidebar-title-link">
      <a href="/" aria-label="Home" style="text-decoration: none;">
        <span class="site-name">{site.name}</span>
      </a>
      <ThemeToggle />
    </div>
  </div>

  <!-- Section 2: Short bio -->
  <div class="sidebar-section sidebar-content">
    <p>{site.tagline}</p>
  </div>

  <!-- Section 3: Main nav links -->
  <div class="sidebar-section">
    <nav aria-label="Main navigation" class="sidebar-nav-links">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[{ active: isActive(link.href) }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          <Fragment set:html={link.icon} />
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  <!-- Section 4: Social / external links -->
  {
    (socialLinks.length > 0 || (contact.email && contact.email.trim() !== '')) && (
      <div class="sidebar-section">
        <div class="sidebar-links">
          {socialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              <Fragment set:html={link.icon} />
              {link.label}
            </a>
          ))}
          {contact.email && contact.email.trim() !== '' && (
            <a href={`mailto:${contact.email}`}>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              Email
            </a>
          )}
        </div>
      </div>
    )
  }

  <!-- Footer: copyright -->
  <div class="sidebar-section">
    <p style="font-size: 13px; color: var(--color-text-muted); margin: 0;">
      &copy; {new Date().getFullYear()} {site.name}
    </p>
  </div>
</aside>

<!-- Mobile header (shown on small screens) -->
<header class="mobile-header">
  <a href="/" aria-label="Home" style="text-decoration: none;">
    <span class="site-name">{site.name}</span>
  </a>
  <div class="mobile-header-right">
    <ThemeToggle />
    <button
      id="mobile-menu-btn"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-nav"
      style="background: transparent; border: none; padding: 0.5rem; cursor: pointer; color: var(--color-text-muted); border-radius: 6px;"
    >
      <!-- Hamburger icon -->
      <svg id="icon-hamburger" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <!-- Close icon -->
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile nav drawer -->
<nav
  id="mobile-nav"
  class="mobile-nav"
  aria-label="Mobile navigation"
  aria-hidden="true"
>
  {navLinks.map((link) => (
    <a
      href={link.href}
      class:list={['mobile-nav-link', { 'mobile-nav-link--active': isActive(link.href) }]}
      aria-current={isActive(link.href) ? 'page' : undefined}
    >
      {link.label}
    </a>
  ))}
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');
  const iconHamburger = document.getElementById('icon-hamburger');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('mobile-nav--open');
    btn.setAttribute('aria-expanded', String(!!isOpen));
    nav?.setAttribute('aria-hidden', String(!isOpen));
    iconHamburger?.classList.toggle('hidden', !!isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>

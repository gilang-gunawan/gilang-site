---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPages = await getCollection('pages');
const aboutPage = allPages.find((p) => p.id === 'about');

const title = aboutPage?.data.title || 'About';
const description = aboutPage?.data.description || 'About this site';
const headings = aboutPage ? (await render(aboutPage)).headings : [];
const Content = aboutPage ? (await render(aboutPage)).Content : null;

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, '');
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: title, item: `${siteUrl}/about` },
  ],
};
---

<BaseLayout title={title} description={description} showTOC={true} headings={headings} jsonLd={[breadcrumbSchema]}>
  <article class="page-article">
    <h1>{title}</h1>

    <div class="prose">
      {Content ? <Content /> : <p>Content coming soon. The content submodule is currently empty.</p>}
    </div>
  </article>
</BaseLayout>

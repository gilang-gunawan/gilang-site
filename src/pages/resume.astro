---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../content/config/site.json';
import { contact, getSocialLinks } from '../site.config';
import resumeUrl from '../content/assets/gilang-gunawan-resume-2026.pdf';

// Fetch resume page content
const allPages = await getCollection('pages');
const resumePage = allPages.find((p) => p.id === 'resume');

const title = resumePage?.data.title || 'Resume';
const description = resumePage?.data.description || 'Resume';
const headings = resumePage ? (await render(resumePage)).headings : [];
const Content = resumePage ? (await render(resumePage)).Content : null;

const socialLinks = getSocialLinks();
const resumeContactItems = [
  'Jakarta, Indonesia',
  contact.phone && contact.phone.trim() !== '' ? contact.phone : undefined,
  contact.email && contact.email.trim() !== '' ? { label: 'Email', href: `mailto:${contact.email}` } : undefined,
  ...socialLinks.map((s) => ({ label: s.label, href: s.href })),
  site.url && site.url.trim() !== '' ? { label: 'Website', href: site.url } : undefined,
].filter((item): item is string | { label: string; href: string } => Boolean(item));
---

<BaseLayout title={title} description={description} showTOC={true} headings={headings} ogImage="/og/resume.png">
  <article class="page-article">
    <h1>{title}</h1>
    <div class="prose">
      <div class="resume-contact">
        <p>
          <a href={resumeUrl} download={`${(site.name || 'Resume').replace(/\s+/g, '_')}_Resume.pdf`}>📥 Download Resume (1-page PDF)</a>
        </p>
        <p>
          {resumeContactItems.map((item, index) => (
            <Fragment key={index}>
              {index > 0 && ' | '}
              {typeof item === 'string' ? (
                item
              ) : (
                <a
                  href={item.href}
                  target={item.href.startsWith('http') ? '_blank' : undefined}
                  rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {item.label}
                </a>
              )}
            </Fragment>
          ))}
        </p>
      </div>
      {Content ? <Content /> : <p>Content coming soon. The content submodule is currently empty.</p>}
    </div>
  </article>
</BaseLayout>

<style>
  .resume-contact p {
    margin: 0.35rem 0;
  }

  .prose h2:first-of-type {
    margin-top: 0.75rem;
  }
</style>

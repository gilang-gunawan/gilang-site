---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../content/config/site.json';
import { contact } from '../site.config';
import resumeUrl from '../content/assets/gilang-gunawan-resume-2026.pdf';

// Fetch resume page content
const allPages = await getCollection('pages');
const resumePage = allPages.find((p) => p.id === 'resume');

if (!resumePage) {
  throw new Error('Missing content/pages/resume.mdx in the content submodule.');
}

const { title, description } = resumePage.data;
const { Content, headings } = await render(resumePage);
---

<BaseLayout title={title} description={description} showTOC={true} headings={headings}>
  <article class="page-article">
    <h1>{title}</h1>
    <div class="prose">
      <div class="resume-contact">
        <p>
          <a href={resumeUrl} download="Gilang_Gunawan_Resume_2026.pdf">📥 Download Resume (1-page PDF)</a>
        </p>
        <p>
          Jakarta, Indonesia | {contact.phone} | <a href={`mailto:${contact.email}`}>Email</a> | <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a> | <a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub</a> | <a href={site.url} target="_blank" rel="noopener noreferrer">Website</a>
        </p>
      </div>
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .resume-contact p {
    margin: 0.35rem 0;
  }

  .prose h2:first-of-type {
    margin-top: 0.75rem;
  }
</style>

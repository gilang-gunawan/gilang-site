---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import GraphView from "../components/GraphView.astro";
import LocalTimeWidget from "../components/LocalTimeWidget.astro";
import { contact, getSocialLinks } from "../site.config";
import site from "../content/config/site.json";
import resumeUrl from "../content/assets/gilang-gunawan-resume-2026.pdf";

// Fetch home page content from pages collection
const allPages = await getCollection("pages");
const homePage = allPages.find((p) => p.id === "home");

const title = homePage?.data.title || "Home";
const description = homePage?.data.description || "Welcome to my site";
const Content = homePage ? (await render(homePage)).Content : null;
const highlights = homePage?.data.highlights ?? [];

// Calls to action under the intro: what a recruiter wants in the first minute.
type CtaLink = { label: string; href: string; download?: string; primary?: boolean };
const ctaLinks: CtaLink[] = [
  {
    label: "Download CV",
    href: resumeUrl,
    download: `${(site.name || "Resume").replace(/\s+/g, "_")}_Resume.pdf`,
    primary: true,
  },
  ...(contact.email && contact.email.trim() !== ""
    ? [{ label: "Email me", href: `mailto:${contact.email}` }]
    : []),
  { label: "Case studies", href: "/projects" },
];

// Contact links sourced from site.json
const socialLinks = getSocialLinks();
const links = [
  ...socialLinks.map((s) => ({ label: s.label, href: s.href })),
  contact.email && contact.email.trim() !== ""
    ? { label: "Email", href: `mailto:${contact.email}` }
    : undefined,
].filter((link): link is { label: string; href: string } =>
  Boolean(link && link.href),
);

// Featured projects: prefer projects explicitly marked `featured`, otherwise
// fall back to the first 4 by order.
const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const sortedProjects = [...allProjects].sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
const featuredProjects = sortedProjects.filter((p) => p.data.featured);
const projectsToShow = (
  featuredProjects.length > 0 ? featuredProjects : sortedProjects
).slice(0, 4);

// Latest writing: 3 most recent published posts.
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title={title} description={description} showGraph={true}>
  <div class="hero hero-index">
    <div class="hero-wrapper">
      <div>
        <h1>{title}</h1>

        <!-- Prose bio from MDX body -->
        <div class="hero-description">
          {
            Content ? (
              <Content />
            ) : (
              <p>
                Welcome to my site. The content submodule is currently empty.
              </p>
            )
          }
        </div>

        {
          highlights.length > 0 && (
            <dl class="home-highlights">
              {highlights.map((item) => (
                <div class="home-highlight">
                  <dt>{item.value}</dt>
                  <dd>{item.label}</dd>
                </div>
              ))}
            </dl>
          )
        }

        <div class="home-cta">
          {
            ctaLinks.map((link) => (
              <a
                href={link.href}
                download={link.download}
                class:list={["home-cta-link", { "is-primary": link.primary }]}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Featured projects -->
  {
    projectsToShow.length > 0 && (
      <section class="home-section">
        <h2 class="home-section-title">Selected Projects</h2>
        <div>
          {projectsToShow.map((project) => (
            <a href={`/projects/${project.id}`} class="home-item">
              <div class="home-item-meta">{project.data.category}</div>
              <h3 class="home-item-title">{project.data.title}</h3>
              <p class="home-item-desc">{project.data.description}</p>
              {project.data.tags && project.data.tags.length > 0 && (
                <div class="home-item-meta">
                  {project.data.tags.map((tag) => (
                    <span class="post-tag">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
        <a href="/projects" class="large-link">
          See all projects →
        </a>
      </section>
    )
  }

  <!-- Latest writing -->
  {
    latestPosts.length > 0 && (
      <section class="home-section">
        <h2 class="home-section-title">Latest Writing</h2>
        <div>
          {latestPosts.map((post) => {
            const formattedDate = post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            });
            return (
              <a href={`/blog/${post.id}`} class="home-item">
                <div class="home-item-meta">
                  <time datetime={post.data.date.toISOString()}>
                    {formattedDate}
                  </time>
                </div>
                <h3 class="home-item-title">{post.data.title}</h3>
                <p class="home-item-desc">{post.data.description}</p>
              </a>
            );
          })}
        </div>
        <a href="/blog" class="large-link">
          Read all posts →
        </a>
      </section>
    )
  }

  <!-- Contact -->
  {
    links.length > 0 && (
      <section class="home-section">
        <h2 class="home-section-title">Get in Touch</h2>
        <div class="large-links">
          {links.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={
                link.href.startsWith("http") ? "noopener noreferrer" : undefined
              }
              class="large-link"
            >
              {link.label}
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Graph and accessories on the right panel -->
  <div slot="graph-panel" class="graph-panel-content">
    <GraphView posts={allPosts} projects={allProjects} />
    <LocalTimeWidget />
  </div>
</BaseLayout>

<style>
  .graph-panel-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .home-highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    max-width: 600px;
  }

  .home-highlight {
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: 0.75rem 0.9rem;
  }

  .home-highlight dt {
    font-family: var(--font-family-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .home-highlight dd {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .home-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .home-cta-link {
    color: var(--color-text-link);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-text);
    text-decoration-style: dotted;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .home-cta-link.is-primary {
    background: var(--color-primary);
    border-radius: var(--border-radius);
    color: #fff;
    padding: 0.55rem 1rem;
    text-decoration: none;
  }

  .home-item time {
    font-size: 0.8rem;
  }

  /* "See all…" / "Read all…" links that follow an item list */
  .home-section > a.large-link {
    margin-top: 1.5rem;
  }
</style>

---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { contact, getSocialLinks } from "../site.config";

// Fetch home page content from pages collection
const allPages = await getCollection("pages");
const homePage = allPages.find((p) => p.id === "home");

if (!homePage) {
  throw new Error("Missing content/pages/home.mdx in the content submodule.");
}

const { title, description } = homePage.data;
const { Content } = await render(homePage);

// Quick nav links below the intro, for fast access on mobile.
// Icons match the ones used for these destinations in the sidebar nav.
const quickLinks = [
  {
    label: "About Me",
    href: "/about",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>`,
  },
  {
    label: "Projects",
    href: "/projects",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>`,
  },
  {
    label: "Resume",
    href: "/resume",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>`,
  },
];

// Contact links sourced from site.json
const socialLinks = getSocialLinks();
const links = [
  ...socialLinks.map((s) => ({ label: s.label, href: s.href })),
  contact.email && contact.email.trim() !== ""
    ? { label: "Email", href: `mailto:${contact.email}` }
    : undefined,
].filter((link): link is { label: string; href: string } =>
  Boolean(link && link.href)
);

// Featured projects: prefer projects explicitly marked `featured`, otherwise
// fall back to the 3 most recent.
const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const sortedProjects = [...allProjects].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featuredProjects = sortedProjects.filter((p) => p.data.featured);
const projectsToShow = (
  featuredProjects.length > 0 ? featuredProjects : sortedProjects
).slice(0, 3);

// Latest writing: 3 most recent published posts.
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title={title} description={description}>
  <div class="hero hero-index">
    <div class="hero-wrapper">
      <div>
        <h1>{title}</h1>

        <!-- Prose bio from MDX body -->
        <div class="hero-description">
          <Content />
        </div>

        <div class="large-links">
          {quickLinks.map((link) => (
            <a href={link.href} class="large-link">
              <Fragment set:html={link.icon} />
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Featured projects -->
  {
    projectsToShow.length > 0 && (
      <section class="home-section">
        <h2 class="home-section-title">Selected Projects</h2>
        <div>
          {projectsToShow.map((project) => (
            <a href={`/projects/${project.id}`} class="home-item">
              <h3 class="home-item-title">{project.data.title}</h3>
              <p class="home-item-desc">{project.data.description}</p>
              {project.data.tags && project.data.tags.length > 0 && (
                <div class="home-item-meta">
                  {project.data.tags.map((tag) => (
                    <span class="post-tag">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
        <a href="/projects" class="large-link">
          See all projects →
        </a>
      </section>
    )
  }

  <!-- Latest writing -->
  {
    latestPosts.length > 0 && (
      <section class="home-section">
        <h2 class="home-section-title">Latest Writing</h2>
        <div>
          {latestPosts.map((post) => {
            const formattedDate = post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            });
            return (
              <a href={`/blog/${post.id}`} class="home-item">
                <div class="home-item-meta">
                  <time datetime={post.data.date.toISOString()}>
                    {formattedDate}
                  </time>
                </div>
                <h3 class="home-item-title">{post.data.title}</h3>
                <p class="home-item-desc">{post.data.description}</p>
              </a>
            );
          })}
        </div>
        <a href="/blog" class="large-link">
          Read all posts →
        </a>
      </section>
    )
  }

  <!-- Contact -->
  {
    links.length > 0 && (
      <section class="home-section">
        <h2 class="home-section-title">Get in Touch</h2>
        <div class="large-links">
          {links.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={
                link.href.startsWith("http")
                  ? "noopener noreferrer"
                  : undefined
              }
              class="large-link"
            >
              {link.label}
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .home-item time {
    font-size: 0.8rem;
  }

  /* "See all…" / "Read all…" links that follow an item list */
  .home-section > a.large-link {
    margin-top: 1.5rem;
  }
</style>

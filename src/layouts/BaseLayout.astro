---
import Sidebar from '../components/Sidebar.astro';
import TOC from '../components/TOC.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import site from '../content/config/site.json';
import { getSocialLinks } from '../site.config';

interface Props {
  title: string;
  description?: string;
  showTOC?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
  showGraph?: boolean;
  ogImage?: string;
  fullWidth?: boolean;
  /** OG type: 'article' for dated content (blog posts), 'website' otherwise. */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** Page-specific schema.org nodes (e.g. BlogPosting, BreadcrumbList) merged into the sitewide @graph. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  showTOC = false,
  headings = [],
  showGraph = false,
  ogImage = '/og/home.png',
  fullWidth = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  tags,
  jsonLd = [],
} = Astro.props;

const fullTitle = title === site.name ? site.name : `${title} — ${site.name}`;
const ogImageUrl = new URL(ogImage, Astro.url);

// Astro.site (from astro.config.mjs) is always defined regardless of whether
// the content submodule is checked out, so entity @ids stay stable across environments.
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialLinks = getSocialLinks();

// Sitewide entity graph: a Person (the site owner, for E-E-A-T) and the WebSite itself.
// Per-page nodes (BlogPosting, BreadcrumbList, etc.) are merged in via the `jsonLd` prop.
const personSchema = {
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: site.name,
  url: siteUrl,
  description: site.description,
  ...(socialLinks.length > 0 ? { sameAs: socialLinks.map((s) => s.href) } : {}),
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: site.name,
  description: site.description,
  publisher: { '@id': `${siteUrl}/#person` },
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [personSchema, websiteSchema, ...jsonLd],
};
// Guard against premature </script> termination if any source text contains it.
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {ogType === 'article' && tags && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{fullTitle}</title>

    <!-- Structured data: sitewide Person + WebSite, plus any page-specific nodes -->
    <script type="application/ld+json" set:html={structuredDataJson} />

    <!-- Prevent flash of wrong theme (must be synchronous, before paint) -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored === 'dark' || (!stored && prefersDark);
        const isLight = stored === 'light' || (!stored && !prefersDark);
        if (isDark) document.documentElement.classList.add('is-dark');
        if (isLight) document.documentElement.classList.add('is-light');
      })();
    </script>
  </head>

  <body>
    <div class:list={['layout', { 'has-toc': showTOC && headings.length > 0, 'has-graph': showGraph }]}>
      <Sidebar />

      <div class="main-wrapper">
        <main class:list={['main-content', { 'full-width': fullWidth }]} id="main-content">
          <slot />
        </main>
        <Footer />
      </div>

      {showTOC && headings.length > 0 && (
        <aside class="toc-panel" aria-label="Table of contents">
          <div class="toc-inner">
            <TOC headings={headings} />
          </div>
        </aside>
      )}

      {showGraph && (
        <aside class="graph-panel">
          <slot name="graph-panel" />
        </aside>
      )}
    </div>
  </body>
</html>

# ─── Content Configuration ───────────────────────────────────────────────────
# If you want to use a local directory for content instead of the src/content
# git submodule, provide the absolute path here.
LOCAL_CONTENT_PATH="/path/to/your/content"

# ─── AI Chatbot Configuration ────────────────────────────────────────────────
# Default provider is 'gemini' (recommended).
AI_PROVIDER=gemini

# Google Gemini API Configuration (Default)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI-Compatible Configuration (Optional if AI_PROVIDER=openai_compatible)
# Can be used for Groq, OpenAI, OpenRouter, or other custom endpoints.
# OPENAI_API_KEY=your_openai_or_groq_api_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# ─── Giscus Comments Configuration (Optional) ────────────────────────────────
# Blog post comments via GitHub Discussions (https://giscus.app). If unset, the
# comments section simply doesn't render — safe to leave blank on a fork.
#
# Setup: enable Discussions on your repo, install the giscus app
# (https://github.com/apps/giscus), then fetch the IDs with:
#   gh api graphql -f query='{ repository(owner:"OWNER", name:"REPO") {
#     id discussionCategories(first:20) { nodes { id name } } } }'
# GISCUS_REPO=your-username/your-repo
# GISCUS_REPO_ID=your_repo_node_id
# GISCUS_CATEGORY=Announcements
# GISCUS_CATEGORY_ID=your_category_node_id

{
  "name": "gilang-site",
  "compatibility_date": "2026-07-27",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "AI_PROVIDER": "gemini",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "GISCUS_CATEGORY": "Announcements",
    "GISCUS_CATEGORY_ID": "DIC_kwDOTlmnIc4DDXxH",
    "GISCUS_REPO": "gilang-gunawan/gilang-site",
    "GISCUS_REPO_ID": "R_kgDOTlmnIQ"
  }
}